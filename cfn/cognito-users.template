AWSTemplateFormatVersion: "2010-09-09"

Description: Pre-created Cognito users for SaaS Visualizer Demo

Transform: AWS::Serverless-2016-10-31

Parameters:
  UserPoolId:
    Type: String
    Description: The ID of the Cognito User Pool
  UserEmailPrefix:
    Type: String
    Description: Email address for the user
  UserEmailSuffix:
    Type: String
    Description: Email address for the user

Resources:
  UsersPassword:
    Type: AWS::SecretsManager::Secret
    Properties:
      Description: !Sub Cognito users login password for ${AWS::StackName}
      GenerateSecretString:
        PasswordLength: 8
        RequireEachIncludedType: True

  SetPasswordCustomResource:
    Type: AWS::Serverless::Function
    Properties:
      CodeUri: custom_resources/set_cognito_user_password/
      Handler: main.handler
      Runtime: python3.12
      Architectures:
        - arm64
      Timeout: 10
      Policies:
        - AWSSecretsManagerGetSecretValuePolicy:
            SecretArn: !Ref UsersPassword
        - Version: "2012-10-17"
          Statement:
            - Effect: Allow
              Action: cognito-idp:AdminSetUserPassword
              Resource: !Sub "arn:${AWS::Partition}:cognito-idp:${AWS::Region}:${AWS::AccountId}:userpool/${UserPoolId}"

  CognitoUser1:
    Type: AWS::Cognito::UserPoolUser
    Properties:
      UserPoolId: !Ref UserPoolId
      Username: !Sub "${UserEmailPrefix}1${UserEmailSuffix}"
      DesiredDeliveryMediums:
        - EMAIL
      UserAttributes:
        - Name: email
          Value: !Sub "${UserEmailPrefix}1${UserEmailSuffix}"
        - Name: email_verified
          Value: "true"
        - Name: custom:tenantName
          Value: 1
        - Name: custom:tenantColor
          Value: "#FF0000"
      MessageAction: SUPPRESS

