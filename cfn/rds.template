Outputs:
  ProxySecurityGroup:
    Value: !Ref ProxySecurityGroup

  ProxyReaderEndpoint:
    Value: !GetAtt ProxyReaderEndpoint.Endpoint

  ProxyWriterEndpoint:
    Value: !GetAtt DBProxy.Endpoint

  ProxyReaderPort:
    Value: !FindInMap [Constants, Global, MysqlPort]

  ProxyWriterPort:
    Value: !FindInMap [Constants, Global, MysqlPort]

  TableName:
    Value: !FindInMap [Constants, Global, InitTableName]

  RdsResourceId:
    Value: !Select
      - 6
      - !Split
        - ':'
        - !GetAtt DBProxy.DBProxyArn