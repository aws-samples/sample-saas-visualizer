# =============================================================================
# AWS IoT Configuration
# =============================================================================

# Path to device-config.json (default: ~/iot-certificates/device-config.json)
# CONFIG_PATH=/path/to/device-config.json

# =============================================================================
# LED Matrix Hardware Configuration
# =============================================================================

# Panel arrangement
# PARALLEL: Number of parallel chains
# CHAIN_LENGTH: Number of panels chained
LED_MATRIX_PARALLEL=2
LED_MATRIX_CHAIN_LENGTH=1

# Display quality settings
# BRIGHTNESS: 0-100
# GPIO_SLOWDOWN: 0-4, higher = more stable but slower
# PWM_BITS: 11 recommended
# PWM_LSB_NANOSECONDS: PWM timing
LED_MATRIX_BRIGHTNESS=70
LED_MATRIX_GPIO_SLOWDOWN=3
LED_MATRIX_PWM_BITS=11
LED_MATRIX_PWM_LSB_NANOSECONDS=130

# Hardware mapping
LED_MATRIX_HARDWARE_MAPPING=regular
LED_MATRIX_DISABLE_HARDWARE_PULSING=false

# =============================================================================
# Application Configuration
# =============================================================================

# Set to "true" to use software emulator instead of hardware
LED_EMULATOR_MODE=false

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
