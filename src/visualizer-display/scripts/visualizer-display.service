[Unit]
Description=LED Matrix Display for SaaS Visualizer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root

# Working directory - adjust path as needed
WorkingDirectory=/home/awsdemo/visualise-saas/src/visualizer-display

# Load LED matrix configuration from .env file
EnvironmentFile=/home/awsdemo/visualise-saas/src/visualizer-display/.env

# Environment setup - LED_EMULATOR_MODE must be false for hardware
Environment="LED_EMULATOR_MODE=false"

# PATH must include location of uv binary
Environment="PATH=/home/awsdemo/.local/bin:/home/awsdemo/.cargo/bin:/usr/local/bin:/usr/bin:/bin"

# Config file path
Environment="CONFIG_PATH=/home/awsdemo/iot-certificates/device-config.json"

# Drop privileges to this user/group after GPIO init (must match file owner)
Environment="LED_MATRIX_DROP_PRIV_USER=awsdemo"
Environment="LED_MATRIX_DROP_PRIV_GROUP=awsdemo"

# Run the display application
ExecStart=/home/awsdemo/.local/bin/uv run python -m visualizer_display --config ${CONFIG_PATH}

# Restart on failure with 10 second delay
Restart=on-failure
RestartSec=10

# Give hardware time to initialize after boot
ExecStartPre=/bin/sleep 5

# Logging to systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=visualizer-display

[Install]
WantedBy=multi-user.target